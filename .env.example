# 백엔드 서버 설정 예시. .env로 복사해 값을 채운다 (.env는 커밋하지 않는다).

# DB 주소. postgresql:// 또는 postgresql+asyncpg:// 모두 된다 (Supabase 주소를 그대로 붙여도 된다).
DATABASE_URL=
# 로그인 토큰 서명 키. 32자 이상 무작위 값이어야 한다.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 브라우저에서 API를 부를 프론트 주소 (쉼표로 여러 개)
CORS_ORIGINS=

# 리뷰 분석(/analyze) 모델. OLLAMA_MODEL은 qlora 모델로 쓴다.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_MODEL_BASE=
OLLAMA_MODEL_LORA=
# 추천 API의 요구사항 해석(파인튜닝 모델)이 이 시간(초)을 넘기면 키워드 규칙으로 대체
RECOMMENDATION_MODEL_TIMEOUT_SECONDS=

# /experiments가 읽을 평가 결과 파일 (베이스·QLoRA 비교 평가 결과)
EXPERIMENTS_METRICS_PATH=evaluation/runs/2026-09-29-base-vs-qlora/automatic_metrics.json

# 로컬 Docker PostgreSQL을 쓸 때 (db/docker-compose.yml). DATABASE_URL을 이 값으로 맞춘다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
